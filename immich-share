def cmd_doctor(args, immich: Immich, edge: Edge):
    """Run read-only checks for a separate or NAS-hosted controller."""
    cfg = args.config_object
    configured_mode = cfg.get("controller", "mode", fallback="separate")
    mode = args.mode or configured_mode
    try:
        expected_peers = cfg.getint(
            "controller",
            "expected_wireguard_peers",
            fallback=2 if mode == "separate" else 1,
        )
    except ValueError:
        die("invalid [controller] expected_wireguard_peers — expected an integer")
    if expected_peers < 1:
        die("[controller] expected_wireguard_peers must be at least 1")

    checks: list[tuple[str, Callable[[], str]]] = []
    if mode == "nas":
        checks.extend(probe_nas_controller(cfg))
    else:
        pf_anchor = cfg.get("controller", "pf_anchor", fallback="wg-inbound")
        controller_address = cfg.get(
            "controller", "controller_wireguard_address", fallback=""
        ).strip()
        checks.extend(
            [
                ("NAS trust-boundary gate", lambda: probe_nas_gate(cfg)),
                ("Controller packet filter", lambda: probe_pf_filter(pf_anchor)),
                (
                    "VPS-to-controller isolation",
                    lambda: edge.probe_controller_blocked(controller_address),
                ),
            ]
        )
    checks.extend(
        [
            (
                "Immich API key permissions",
                lambda: probe_api_key_permissions(immich.api_key_file),
            ),
            (
                "Managed-share state permissions",
                lambda: probe_state_permissions(args.managed_state),
            ),
            ("Immich scoped API", immich.probe),
            ("VPS SSH", edge.probe_ssh),
            ("VPS services", edge.probe_services),
            ("VPS container hardening", edge.probe_container_hardening),
            ("VPS published ports", edge.probe_published_ports),
            ("Download-guard runtime logging", edge.probe_download_guard_logging),
            (
                "VPS live refusal and log redaction",
                lambda: edge.probe_vps_runtime_redaction(immich.public_base),
            ),
            ("VPS staging disk", edge.probe_disk),
            ("WireGuard handshakes", lambda: edge.probe_wireguard(expected_peers)),
            ("VPS bridge containment", edge.probe_forward_containment),
            ("Public portal default", lambda: probe_public_root(immich.public_base)),
        ]
    )

    print(f"immich-share doctor — controller mode: {mode}")
    failures = 0
    for label, probe in checks:
        try:
            detail = probe()
            print(f"  ✓ {label}: {detail}")
        except Exception as exc:
            failures += 1
            print(f"  ✗ {label}: {str(exc)[:240]}")
    if failures:
        print(f"\nDoctor found {failures} failing check(s).")
        return 1
    print("\nAll read-only checks passed.")
    return 0


def cmd_open(args, immich: Immich, edge: Edge):
    """Create the link and open the edge. With --json, stdout carries exactly
    one JSON object and every progress line goes to stderr, so a caller never
    has to parse human-readable output."""
    json_output = getattr(args, "json_output", False)
    machine_stdout = sys.stdout
    with contextlib.redirect_stdout(sys.stderr if json_output else sys.stdout):
        result = _open_share(args, immich, edge)
    if json_output:
        json.dump(result, machine_stdout, sort_keys=True)
        machine_stdout.write("\n")
        machine_stdout.flush()


def _open_share(args, immich: Immich, edge: Edge) -> dict:
    album = immich.find_album(args.album)
    prior_active = managed_links(immich, args.managed_state)
    ttl = parse_ttl(args.ttl)
    if ttl > args.max_ttl:
        die(f"TTL {args.ttl} exceeds the configured maximum")
    expires_at = (datetime.now(timezone.utc) + ttl).strftime("%Y-%m-%dT%H:%M:%S.000Z")
    password = resolve_open_password(args)
    # HIGH: the description is inserted into an imported Caddy comment. Remove
    # line breaks so it cannot inject directives.
    description = clean_description(args.for_ or "")

    link = immich.create_link(
        album["id"],
        password,
        expires_at,
        description,
        allow_download=args.allow_download,
    )
    key = check_key(link["key"])
    try:
        args.managed_state.add(link)
    except Exception as exc:
        immich.delete_link(link["id"])
        die(f"could not record share ownership; Immich link rolled back: {exc}")
    print(
        f"  ✓ Immich link created ({album['albumName']}, {album.get('assetCount', '?')} assets)"
    )

    try:
        # Enable the NAS forward first so Caddy never exposes a temporarily dead route.
        edge.nas_forward(on=True)
        edge.write_snippet(
            GLOBALS_SNIPPET_NAME, GLOBALS_SNIPPET.format(upstream=edge.upstream)
        )
        edge.write_snippet(
            f"{key}.caddy",
            render_share_snippet(edge, key, description, expires_at),
        )
        edge.reload()
    except BaseException:
        # A reported failure must not become public after a later Caddy reload.
        print(
            "  ! opening the edge failed; rolling back the new share", file=sys.stderr
        )
        try:
            edge.remove_snippets([f"{key}.caddy"])
            if not prior_active:
                edge.remove_snippets([GLOBALS_SNIPPET_NAME])
            edge.reload()
        except BaseException as cleanup_error:
            print(f"  ! VPS rollback needs attention: {cleanup_error}", file=sys.stderr)
        if not prior_active:
            try:
                edge.nas_forward(on=False)
            except BaseException as cleanup_error:
                print(
                    f"  ! NAS rollback needs attention: {cleanup_error}",
                    file=sys.stderr,
                )
        try:
            immich.delete_link(link["id"])
        except BaseException as cleanup_error:
            print(
                f"  ! Immich rollback needs attention: {cleanup_error}", file=sys.stderr
            )
        else:
            args.managed_state.remove([key])
        raise

    print()
    public_link = f"{immich.public_base}/share/{key}"
    print(f"  Link     : {public_link}")
    print(f"  Password : {password}")
    print(f"  Expires  : {expires_at}  (TTL {args.ttl})")
    if description:
        print(f"  For      : {description}")
    qr_with_password = getattr(args, "qr_with_password", False)
    if getattr(args, "qr", False) or qr_with_password:
        qr_url = qr_share_url(public_link, password, qr_with_password)
        print()
        if qr_with_password:
            print("  Scan this QR code to open and unlock the share:")
        else:
            print("  Scan this QR code to open the share link:")
        if print_terminal_qr(qr_url):
            if qr_with_password:
                print("  The QR code contains both the link and password. Treat it as a credential.")
            else:
                print("  The QR code contains only the link. Send the password separately.")
    print()
    if qr_with_password:
        print("  📤 One-scan mode: send the QR as a credential; anyone holding it can unlock the share.")
    else:
        print(
            "  📤 Two-channel rule: send the link by email/WhatsApp and the password by SMS/Signal/voice."
        )
    return {
        "key": key,
        "link": public_link,
        "password": password,
        "expiresAt": expires_at,
        "description": description,
        "album": {
            "name": album.get("albumName", ""),
            "assetCount": album.get("assetCount"),
        },
        "allowDownload": bool(args.allow_download),
    }


def cmd_list(args, immich: Immich, edge: Edge):
    links = immich.list_links()
    owned = args.managed_state.keys()
    snippets = {s.removesuffix(".caddy") for s in edge.list_snippets()} - {
        GLOBALS_SNIPPET_NAME.removesuffix(".caddy")
    }
    if getattr(args, "json_output", False):
        rows = []
        for link in links:
            key = link.get("key", "")
            rows.append(
                {
                    "key": key,
                    "expiresAt": link.get("expiresAt"),
                    "expired": expired(link),
                    "managed": key in owned,
                    "portalOpen": key in snippets,
                    "description": link.get("description") or "",
                    "album": (link.get("album") or {}).get("albumName", ""),
                }
            )
        json.dump(
            {
                "shares": rows,
                "orphanSnippets": sorted(
                    snippets - {link.get("key") for link in links}
                ),
            },
            sys.stdout,
            sort_keys=True,
        )
        sys.stdout.write("\n")
        return
    if not links:
        print("No shared links. Portal closed.")
        return
    for link in links:
        key = link.get("key", "?")
        state = "EXPIRED" if expired(link) else "active "
        owner = "managed" if key in owned else "external"
        portal = "portal open" if key in snippets else "portal closed"
        desc = link.get("description") or link.get("album", {}).get("albumName", "")
        print(
            f"  {key[:10]}…  {state} {owner} exp={link.get('expiresAt', 'never')}  {portal}  {desc}"
        )
    orphans = snippets - {link.get("key") for link in links}
    for o in orphans:
        print(
            f"  ⚠️ orphan VPS snippet (link removed from Immich): {o[:10]}… → run `sweep`"
        )


def cmd_close(args, immich: Immich, edge: Edge):
    owned = args.managed_state.keys()
    links = [
        link
        for link in immich.list_links()
        if link.get("key") in owned and link.get("key", "").startswith(args.key)
    ]
    if not links:
        die(f"no link has a key starting with '{args.key}'")
    if len(links) > 1:
        die(f"ambiguous prefix ({len(links)} links) — provide a longer prefix")
    link = links[0]
    immich.delete_link(link["id"])
    args.managed_state.remove([link["key"]])
    print(f"  ✓ Immich link removed ({link.get('description') or link['key'][:10]})")
    _sync_portal(immich, edge, args.managed_state)


def cmd_sweep(args, immich: Immich, edge: Edge):
    removed = 0
    removed_keys = []
    for link in managed_links(immich, args.managed_state, include_expired=True):
        if expired(link):
            immich.delete_link(link["id"])
            removed_keys.append(link["key"])
            removed += 1
    args.managed_state.remove(removed_keys)
    if removed:
        print(f"  ✓ removed {removed} expired Immich link(s)")
    _sync_portal(immich, edge, args.managed_state)


def cmd_sync(args, immich: Immich, edge: Edge):
    """Regenerate active snippets after a Caddy routing change."""
    links = managed_links(immich, args.managed_state)
    if not links:
        snippets = edge.list_snippets()
        if snippets:
            edge.remove_snippets(snippets)
            edge.reload()
        edge.nas_forward(on=False)
        print("  Portal fully closed (no active shares).")
        return

    edge.nas_forward(on=True)
    edge.write_snippet(
        GLOBALS_SNIPPET_NAME, GLOBALS_SNIPPET.format(upstream=edge.upstream)
    )
    active_names = set()
    for link in links:
        key = check_key(link["key"])
        active_names.add(f"{key}.caddy")
        description = link.get("description") or link.get("album", {}).get(
            "albumName", ""
        )
        expires = link.get("expiresAt") or "never"
        edge.write_snippet(
            f"{key}.caddy",
            render_share_snippet(edge, key, description, expires),
        )

    stale = [
        name
        for name in edge.list_snippets()
        if name != GLOBALS_SNIPPET_NAME and name not in active_names
    ]
    edge.remove_snippets(stale)
    edge.reload()
    print(f"  ✓ resynchronized {len(links)} active share(s)")


def cmd_adopt(args, immich: Immich, edge: Edge):
    """Explicitly adopt one existing Immich link; never happens during sync."""
    matches = [
        link for link in immich.list_links() if link.get("key", "").startswith(args.key)
    ]
    if not matches:
        die(f"no Immich link has a key starting with '{args.key}'")
    if len(matches) > 1:
        die(f"ambiguous prefix ({len(matches)} links) — provide a longer prefix")
    link = matches[0]
    if expired(link):
        die("refusing to adopt an expired link")
    if not link.get("expiresAt"):
        die("refusing to adopt a link without an expiration")
    args.managed_state.add(link)
    print("  ✓ existing Immich link explicitly adopted")
    cmd_sync(args, immich, edge)


def _sync_portal(immich: Immich, edge: Edge, state: ManagedShares):
    """Converge portal state on active Immich links. This is idempotent."""
    active = {check_key(link["key"]) for link in managed_links(immich, state)}
    snippets = edge.list_snippets()
    stale = [
        s
        for s in snippets
        if s != GLOBALS_SNIPPET_NAME and s.removesuffix(".caddy") not in active
    ]
    if not active:
        stale = snippets  # No active links: remove the global routes as well.
    if stale:
        edge.remove_snippets(stale)
        print(f"  ✓ removed {len(stale)} Caddy snippet(s)")
        edge.reload()
    if not active:
        edge.nas_forward(on=False)
        print("  Portal fully closed (no public attack surface).")
    else:
        print(f"  {len(active)} share(s) still active.")


def main():
    p = argparse.ArgumentParser(
        prog="immich-share", description=__doc__.splitlines()[0]
    )
    p.add_argument(
        "--config",
        help="configuration path (default: user config, then project config)",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    po = sub.add_parser("open", help="create a share and open the portal")
    po.add_argument("album")
    po.add_argument(
        "--ttl",
        default=None,
        help="24h, 48h, 7d, etc. (otherwise [sharing] default_ttl)",
    )
    po.add_argument(
        "--for", dest="for_", default="", help="recipient label (one link per person)"
    )
    po.add_argument(
        "--json",
        dest="json_output",
        action="store_true",
        help="print one JSON object on stdout (progress goes to stderr)",
    )
    qr = po.add_mutually_exclusive_group()
    qr.add_argument(
        "--qr",
        action="store_true",
        help="print a terminal QR code for the link (requires qrencode)",
    )
    qr.add_argument(
        "--qr-with-password",
        action="store_true",
        help="print a one-scan QR containing the link and password fragment (requires qrencode)",
    )
    passwords = po.add_mutually_exclusive_group()
    passwords.add_argument(
        "--password",
        dest="prompt_password",
        action="store_true",
        help="prompt twice without exposing the password in shell history or process listings",
    )
    passwords.add_argument(
        "--password-file",
        help="read a custom password from a private regular file owned by the current user",
    )
    downloads = po.add_mutually_exclusive_group()
    downloads.add_argument(
        "--download",
        dest="allow_download",
        action="store_true",
        help="allow downloads for this share",
    )
    downloads.add_argument(
        "--no-download",
        dest="allow_download",
        action="store_false",
        help="disable downloads for this share",
    )
    po.set_defaults(fn=cmd_open, allow_download=None)

    pl = sub.add_parser("list", help="active links and portal state")
    pl.add_argument(
        "--json",
        dest="json_output",
        action="store_true",
        help="print the share list as JSON",
    )
    pl.set_defaults(fn=cmd_list)

    sub.add_parser(
        "sync", help="regenerate routes for every active share"
    ).set_defaults(fn=cmd_sync)

    pc = sub.add_parser("close", help="revoke a share (key or prefix)")
    pc.add_argument("key")
    pc.set_defaults(fn=cmd_close)

    pa = sub.add_parser("adopt", help="explicitly manage one existing Immich link")
    pa.add_argument("key", help="existing Immich share key or unambiguous prefix")
    pa.set_defaults(fn=cmd_adopt)

    sub.add_parser(
        "sweep", help="purge expired links and close the portal (timer)"
    ).set_defaults(fn=cmd_sweep)

    pd = sub.add_parser("doctor", help="run read-only installation and security checks")
    pd.add_argument(
        "--mode", choices=("separate", "nas"), help="override [controller] mode"
    )
    pd.set_defaults(fn=cmd_doctor)

    args = p.parse_args()
    cfg = load_config(args.config)
    args.config_object = cfg
    args.managed_state = ManagedShares(cfg)
    if args.cmd == "open":
        args.ttl = args.ttl or cfg.get("sharing", "default_ttl", fallback="24h")
        args.max_ttl = parse_ttl(cfg.get("sharing", "max_ttl", fallback="30d"))
        if args.allow_download is None:
            try:
                args.allow_download = cfg.getboolean(
                    "sharing", "default_allow_download", fallback=True
                )
            except ValueError:
                die("invalid [sharing] default_allow_download — expected true or false")
    # One owner is still required operationally, but this prevents concurrent
    # monitor, cron, and terminal mutations on the same controller.
    # Read-only commands take a shared lock: list and doctor may overlap each
    # other and never write state. A mutating command still waits for them.
    with args.managed_state.lock(exclusive=args.cmd not in {"list", "doctor"}):
        result = args.fn(args, Immich(cfg), Edge(cfg))
    if isinstance(result, int):
        raise SystemExit(result)


if __name__ == "__main__":
    main()
