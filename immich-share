#!/usr/bin/env python3
"""immich-share — share Immich albums through a closed-by-default portal.

Creates an Immich shared link AND opens the matching Caddy routes on the VPS
and nginx forward on the NAS, then closes everything on expiry (sweep).

Standard library only. Commands:
    immich-share open  "Summer 2026" --ttl 24h --for "Alex"
    immich-share list
    immich-share close <key|prefix>
    immich-share sweep
    immich-share doctor
"""

