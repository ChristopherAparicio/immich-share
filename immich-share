def die(msg: str, code: int = 1):
    print(f"❌ {msg}", file=sys.stderr)
    sys.exit(code)


def load_config(explicit_path: str | None = None) -> configparser.ConfigParser:
    cfg = configparser.ConfigParser()
    candidates = [Path(explicit_path).expanduser()] if explicit_path else CONFIG_PATHS
    for p in candidates:
        contents = read_private_file(
            p, "configuration", max_bytes=1024 * 1024, allow_missing=True
        )
        if contents is not None:
            try:
                cfg.read_string(contents, source=str(p))
            except configparser.Error as exc:
                die(f"invalid configuration {p}: {exc}")
            cfg.source_path = p
            return cfg
    die(
        f"no configuration found ({' or '.join(str(p) for p in candidates)}) — copy config.example.ini"
    )


class _RefuseRedirects(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect.

    The default handler re-sends every request header (including the Immich
    API key) and, for 307/308, the body (the share password) to whatever host
    and scheme the Location header names, so an HTTPS -> HTTP hop or a hostile
    reverse proxy in front of Immich would exfiltrate the key. A redirect is a
    configuration error and surfaces as an HTTPError 3xx instead.
    """

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


# Shared opener for every HTTP call made by this tool.
HTTP_OPENER = urllib.request.build_opener(_RefuseRedirects)


class Immich:
    def __init__(self, cfg):
        self.url = cfg["immich"]["url"].rstrip("/")
        parsed = urllib.parse.urlsplit(self.url)
        if parsed.scheme not in {"http", "https"} or not parsed.hostname:
            die("[immich] url must be an absolute HTTP(S) URL")
        if parsed.scheme == "http" and not _loopback_host(parsed.hostname):
            try:
                private_tunnel = cfg.getboolean(
                    "immich", "allow_http_over_private_tunnel", fallback=False
                )
            except ValueError:
                die(
                    "invalid [immich] allow_http_over_private_tunnel — expected true or false"
                )
            if not private_tunnel:
                die(
                    "refusing to send the Immich API key over clear-text HTTP; "
                    "use HTTPS, loopback, or explicitly confirm an encrypted private tunnel"
                )
        key_file = Path(cfg["immich"]["api_key_file"]).expanduser()
        self.api_key = read_private_secret(key_file, "Immich API key")
        self.api_key_file = key_file
        self.public_base = cfg["immich"]["public_base_url"].rstrip("/")
        public = urllib.parse.urlsplit(self.public_base)
        if public.scheme != "https" or not public.hostname:
            die("[immich] public_base_url must be an absolute HTTPS URL")

    def _call(self, method: str, path: str, body=None):
        req = urllib.request.Request(
            f"{self.url}/api{path}",
            method=method,
            headers={
                "x-api-key": self.api_key,
                "Content-Type": "application/json",
                "Accept": "application/json",
            },
            data=json.dumps(body).encode() if body is not None else None,
        )
        try:
            with HTTP_OPENER.open(req, timeout=15) as r:
                data = r.read()
                return json.loads(data) if data else None
        except urllib.error.HTTPError as e:
            if 300 <= e.code < 400:
                die(
                    f"Immich {method} {path} answered with a redirect (HTTP {e.code}); "
                    "refusing to follow it with the API key — point [immich] url at "
                    "the final address"
                )
            die(
                f"Immich {method} {path} → HTTP {e.code} : {e.read().decode(errors='replace')[:300]}"
            )
        except urllib.error.URLError as e:
            die(f"Immich is unreachable ({self.url}): {e.reason}")

    def find_album(self, name: str) -> dict:
        albums = self._call("GET", "/albums")
        if UUID_RE.fullmatch(name):
            by_id = [a for a in albums if str(a.get("id", "")).lower() == name.lower()]
            if not by_id:
                die(f"no album has the id '{name}'")
            return by_id[0]
        matches = [a for a in albums if a["albumName"].lower() == name.lower()]
        if not matches:
            close = [
                a["albumName"] for a in albums if name.lower() in a["albumName"].lower()
            ]
            hint = f" — close matches: {', '.join(close[:5])}" if close else ""
            die(f"album '{name}' not found{hint}")
        if len(matches) > 1:
            die(f"multiple albums are named '{name}' — rename one or pass its UUID")
        return matches[0]

    def create_link(
        self,
        album_id: str,
        password: str,
        expires_at: str,
        description: str,
        allow_download: bool,
    ) -> dict:
        return self._call(
            "POST",
            "/shared-links",
            {
                "type": "ALBUM",
                "albumId": album_id,
                "password": password,
                "expiresAt": expires_at,
                "allowDownload": allow_download,
                "allowUpload": False,
                # Immich >= 2.6 forces allowDownload=false when showMetadata=false:
                # an original may contain EXIF/GPS data. ipp-config.json still keeps
                # every metadata field hidden in the public IPP interface. Disabling
                # downloads also disables metadata at the shared-link source.
                "showMetadata": allow_download,
                "description": description,
            },
        )

    def list_links(self) -> list:
        return self._call("GET", "/shared-links")

    def delete_link(self, link_id: str):
        self._call("DELETE", f"/shared-links/{link_id}")

    def probe(self) -> str:
        """Validate scoped API access without exposing album or asset details."""
        req = urllib.request.Request(
            f"{self.url}/api/albums",
            headers={"x-api-key": self.api_key, "Accept": "application/json"},
        )
        try:
            with HTTP_OPENER.open(req, timeout=10) as response:
                albums = json.load(response)
        except urllib.error.HTTPError as exc:
            if 300 <= exc.code < 400:
                raise RuntimeError(f"HTTP {exc.code} redirect refused") from exc
            raise RuntimeError(f"HTTP {exc.code}") from exc
        except (urllib.error.URLError, ValueError) as exc:
            raise RuntimeError(str(exc)) from exc
        return f"scoped API access ({len(albums)} albums)"


class ManagedShares:
    """Local ownership registry for links created or explicitly adopted here."""

    def __init__(self, cfg):
        configured = cfg.get("sharing", "managed_state_file", fallback="").strip()
        self.path = (
            Path(configured).expanduser()
            if configured
            else Path.home() / ".config/immich-share/managed-shares.json"
        )
        self.lock_path = self.path.with_suffix(self.path.suffix + ".lock")

    def _prepare_parent(self):
        self.path.parent.mkdir(parents=True, mode=0o700, exist_ok=True)

    @contextmanager
    def lock(self, exclusive: bool = True):
        self._prepare_parent()
        flags = os.O_RDWR | os.O_CREAT
        if hasattr(os, "O_NOFOLLOW"):
            flags |= os.O_NOFOLLOW
        fd = os.open(self.lock_path, flags, 0o600)
        try:
            os.fchmod(fd, 0o600)
            fcntl.flock(fd, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
            yield
        finally:
            fcntl.flock(fd, fcntl.LOCK_UN)
            os.close(fd)

    def _read(self) -> dict:
        # Same discipline as the configuration and secrets: regular file,
        # owned by the current user, private, never a symlink.
        contents = read_private_file(
            self.path, "managed-share state", max_bytes=8 * 1024 * 1024, allow_missing=True
        )
        if contents is None:
            return {"version": 1, "shares": {}}
        try:
            data = json.loads(contents)
        except ValueError as exc:
            die(f"managed-share state is unreadable: {exc}")
        if data.get("version") != 1 or not isinstance(data.get("shares"), dict):
            die("managed-share state has an unsupported format")
        for key in data["shares"]:
            check_key(key)
        return data

    def keys(self) -> set[str]:
        return set(self._read()["shares"])

    def add(self, link: dict):
        key = check_key(link["key"])
        data = self._read()
        data["shares"][key] = {
            "id": link.get("id", ""),
            "expiresAt": link.get("expiresAt"),
            "recordedAt": datetime.now(timezone.utc).isoformat(),
        }
        self._write(data)

    def remove(self, keys):
        data = self._read()
        changed = False
        for key in keys:
            changed = data["shares"].pop(key, None) is not None or changed
        if changed:
            self._write(data)

    def _write(self, data: dict):
        self._prepare_parent()
        fd, temporary = tempfile.mkstemp(
            dir=self.path.parent, prefix=f".{self.path.name}.", text=True
        )
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "w") as handle:
                json.dump(data, handle, indent=2, sort_keys=True)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary, self.path)
            self.path.chmod(0o600)
        except Exception:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            raise


class Edge:
    """Control the VPS Caddy routes and NAS forward through configured commands.

    SSH agent forwarding is always disabled.
    """

    def __init__(self, cfg):
        v = cfg["vps"]
        self.ssh_target = v["ssh"]
        if not re.fullmatch(
            r"(?:[A-Za-z0-9_.-]+@)?(?:[A-Za-z0-9_.-]+|\[[0-9A-Fa-f:]+\])",
            self.ssh_target,
        ):
            die("invalid [vps] ssh target; use an SSH alias or user@host")
        # Host-side directory that Compose bind-mounts at /etc/caddy/shares.d.
        self.shares_dir = v.get("shares_dir", "/srv/photo-share/shares.d")
        self.validate_cmd = v["caddy_validate_cmd"]
        self.reload_cmd = v["caddy_reload_cmd"]
        self.upstream = v.get("ipp_upstream", "ipp:3000")
        self.download_upstream = v.get("download_guard_upstream", "download-guard:8080")
        upstream_re = re.compile(r"^[A-Za-z0-9_.-]+:[1-9][0-9]{0,4}$")
        if not upstream_re.fullmatch(self.upstream):
            die("invalid [vps] ipp_upstream")
        if not upstream_re.fullmatch(self.download_upstream):
            die("invalid [vps] download_guard_upstream")
        self.deployment_dir = v.get("deployment_dir", "/srv/photo-share")
        n = cfg["nas"]
        self.forward_on_cmd = n["forward_on_cmd"]
        self.forward_off_cmd = n["forward_off_cmd"]

    def _ssh(
        self, remote_cmd: str, stdin: str | None = None
    ) -> subprocess.CompletedProcess:
        return subprocess.run(
            [
                "ssh",
                "-o",
                "ForwardAgent=no",
                "-o",
                "BatchMode=yes",
                "-o",
                "ConnectTimeout=10",
                self.ssh_target,
                remote_cmd,
            ],
            input=stdin,
            capture_output=True,
            text=True,
        )

    def _local(self, cmd: str) -> subprocess.CompletedProcess:
        # shell=True is intentional: forward_on/off_cmd come from trusted
        # operator configuration, never from user input.
        return subprocess.run(cmd, shell=True, capture_output=True, text=True)

    def nas_forward(self, on: bool):
        r = self._local(self.forward_on_cmd if on else self.forward_off_cmd)
        if r.returncode != 0:
            die(
                f"NAS forward {'on' if on else 'off'} failed: {(r.stderr or r.stdout).strip()[:300]}"
            )
        print(f"  ✓ NAS forward {'enabled' if on else 'disabled'}")

    def list_snippets(self) -> list[str]:
        r = self._ssh(f"ls -1 {shlex.quote(self.shares_dir)} 2>/dev/null || true")
        if r.returncode != 0:
            die(f"VPS SSH failed: {r.stderr.strip()[:300]}")
        valid = re.compile(r"^(?:00-globals|[A-Za-z0-9_-]{8,128})\.caddy$")
        return [line for line in r.stdout.splitlines() if valid.fullmatch(line)]

    def write_snippet(self, name: str, content: str):
        """Write and validate a snippet before reloading, rolling it back on error."""
        if not re.fullmatch(r"(?:00-globals|[A-Za-z0-9_-]{8,128})\.caddy", name):
            die("refusing an invalid Caddy snippet name")
        path = f"{self.shares_dir}/{name}"
        nonce = secrets.token_hex(8)
        temporary = f"{path}.tmp-{nonce}"
        backup = f"{path}.bak-{nonce}"
        r = self._ssh(
            f"umask 027; cat > {shlex.quote(temporary)} && "
            f"if test -e {shlex.quote(path)}; then cp -p {shlex.quote(path)} {shlex.quote(backup)}; fi && "
            f"mv {shlex.quote(temporary)} {shlex.quote(path)}",
            stdin=content,
        )
        if r.returncode != 0:
            die(f"failed to write Caddy snippet: {r.stderr.strip()[:300]}")
        v = self._ssh(self.validate_cmd)
        if v.returncode != 0:
            self._ssh(
                f"if test -e {shlex.quote(backup)}; then "
                f"mv {shlex.quote(backup)} {shlex.quote(path)}; "
                f"else rm -f {shlex.quote(path)}; fi; "
                f"rm -f {shlex.quote(temporary)}"
            )
            die(
                "Caddy validation failed — previous snippet restored, running Caddy unchanged:\n"
                f"{(v.stderr or v.stdout).strip()[:500]}"
            )
        self._ssh(f"rm -f {shlex.quote(backup)} {shlex.quote(temporary)}")

    def remove_snippets(self, names: list[str]):
        if names:
            valid = re.compile(r"^(?:00-globals|[A-Za-z0-9_-]{8,128})\.caddy$")
            if any(not valid.fullmatch(name) for name in names):
                die("refusing to remove an invalid Caddy snippet name")
            files = " ".join(shlex.quote(f"{self.shares_dir}/{n}") for n in names)
            result = self._ssh(f"rm -f {files}")
            if result.returncode != 0:
                die(f"failed to remove Caddy snippets: {result.stderr.strip()[:300]}")

    def reload(self):
        r = self._ssh(self.reload_cmd)
        if r.returncode != 0:
            die(f"Caddy reload failed: {(r.stderr or r.stdout).strip()[:300]}")
        print("  ✓ Caddy reloaded")

    def probe_ssh(self) -> str:
        r = self._ssh("true")
        if r.returncode != 0:
            raise RuntimeError(
                (r.stderr or r.stdout).strip()[:200] or "connection failed"
            )
        return self.ssh_target

    def probe_services(self) -> str:
        directory = shlex.quote(self.deployment_dir)
        r = self._ssh(
            f"cd {directory} && docker compose ps --services --status running"
        )
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200])
        running = set(r.stdout.split())
        expected = {"caddy", "ipp", "download-guard"}
        missing = expected - running
        if missing:
            raise RuntimeError(f"not running: {', '.join(sorted(missing))}")
        return ", ".join(sorted(expected))

    def probe_container_hardening(self) -> str:
        r = self._ssh(
            "docker inspect --format "
            "'{{.Config.User}}|{{.HostConfig.ReadonlyRootfs}}|{{json .HostConfig.CapDrop}}|"
            "{{json .HostConfig.SecurityOpt}}|{{json .HostConfig.CapAdd}}' "
            "caddy ipp download-guard"
        )
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200])
        lines = r.stdout.splitlines()
        if len(lines) != 3:
            raise RuntimeError("unexpected Docker inspection output")
        for service, line in zip(("caddy", "ipp", "download-guard"), lines):
            user, readonly, drops_raw, options_raw, adds_raw = line.split("|", 4)
            drops = set(json.loads(drops_raw) or [])
            options = set(json.loads(options_raw) or [])
            adds = set(json.loads(adds_raw) or [])
            if not user or user in {"0", "root", "0:0"}:
                raise RuntimeError(f"{service} runs as root")
            if readonly != "true" or drops != {"ALL"}:
                raise RuntimeError(f"{service} is missing read-only/cap-drop hardening")
            if not any(option.startswith("no-new-privileges") for option in options):
                raise RuntimeError(f"{service} permits privilege escalation")
            expected_adds = {"NET_BIND_SERVICE"} if service == "caddy" else set()
            if adds != expected_adds:
                raise RuntimeError(
                    f"{service} has unexpected added capabilities: {adds}"
                )
        return "non-root, read-only, cap-drop=ALL"

    def probe_published_ports(self) -> str:
        r = self._ssh(
            "docker inspect --format '{{json .HostConfig.PortBindings}}' "
            "caddy ipp download-guard"
        )
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200])
        lines = r.stdout.splitlines()
        if len(lines) != 3:
            raise RuntimeError("unexpected Docker port inspection output")
        bindings = [json.loads(line) if line not in {"", "null"} else {} for line in lines]
        caddy_ports = set(bindings[0])
        if caddy_ports != {"80/tcp", "443/tcp"}:
            raise RuntimeError(f"unexpected Caddy published ports: {sorted(caddy_ports)}")
        if bindings[1] or bindings[2]:
            raise RuntimeError("IPP or download-guard has a published host port")
        return "only Caddy TCP 80/443 are published"

    def probe_download_guard_logging(self) -> str:
        r = self._ssh(
            "config=$(docker exec download-guard nginx -T 2>/dev/null) || exit 1; "
            "count=$(printf '%s\\n' \"$config\" | grep -F -c 'error_log /dev/null'); "
            "test \"$count\" -ge 2; "
            "! printf '%s\\n' \"$config\" | grep -F -q 'error_log /dev/stderr'"
        )
        if r.returncode != 0:
            raise RuntimeError("effective download-guard error logging is unsafe")
        return "effective runtime error logs are disabled"

    def probe_vps_runtime_redaction(self, public_base: str) -> str:
        sentinel = "DOCTOR" + secrets.token_hex(12).upper()
        marker = "IMMICHSHAREDOCTOR" + secrets.token_hex(8).upper()
        url = public_base.rstrip("/") + "/auth/login?key=" + sentinel
        request = urllib.request.Request(
            url, headers={"User-Agent": marker}
        )
        try:
            with HTTP_OPENER.open(request, timeout=10) as response:
                raise RuntimeError(f"forbidden route returned HTTP {response.status}")
        except urllib.error.HTTPError as exc:
            if exc.code != 404:
                raise RuntimeError(
                    f"forbidden route returned HTTP {exc.code}; expected 404"
                ) from exc
        except urllib.error.URLError as exc:
            raise RuntimeError(str(exc.reason)) from exc

        quoted_sentinel = shlex.quote(sentinel)
        quoted_marker = shlex.quote(marker)
        directory = shlex.quote(self.deployment_dir)
        r = self._ssh(
            f"sentinel={quoted_sentinel}; marker={quoted_marker}; "
            "recorded=0; for attempt in 1 2 3 4 5; do "
            f"grep -R -F -q \"$marker\" {directory}/caddy-data 2>/dev/null "
            "&& { recorded=1; break; }; sleep 1; done; "
            "test \"$recorded\" -eq 1 || exit 43; "
            "for container in caddy ipp download-guard; do "
            "docker logs \"$container\" 2>&1 | grep -F -q \"$sentinel\" && exit 41; "
            "done; "
            f"grep -R -F -q \"$sentinel\" {directory}/caddy-data 2>/dev/null && exit 42; "
            "exit 0"
        )
        if r.returncode in {41, 42}:
            raise RuntimeError("query sentinel leaked into VPS runtime logs")
        if r.returncode == 43:
            raise RuntimeError("Caddy diagnostic request was not observable in its access log")
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200] or "log probe failed")
        return "forbidden route refused and query sentinel absent from live logs"

    def probe_disk(self) -> str:
        directory = shlex.quote(self.deployment_dir)
        r = self._ssh(f"df -Pk {directory} | awk 'NR==2 {{print $4}}'")
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200])
        try:
            available = int(r.stdout.strip()) * 1024
        except ValueError as exc:
            raise RuntimeError("unexpected df output") from exc
        return f"{available / (1024**3):.1f} GiB available"

    def probe_wireguard(self, expected_peers: int) -> str:
        r = self._ssh(
            "sudo -n wg show wg0 latest-handshakes 2>/dev/null "
            "|| wg show wg0 latest-handshakes 2>/dev/null"
        )
        if r.returncode != 0:
            raise RuntimeError("unable to read wg0 handshakes")
        epochs = []
        for line in r.stdout.splitlines():
            fields = line.split()
            if len(fields) >= 2 and fields[-1].isdigit():
                epochs.append(int(fields[-1]))
        now = int(time.time())
        recent = sum(1 for epoch in epochs if epoch > 0 and now - epoch < 300)
        if recent < expected_peers:
            raise RuntimeError(f"{recent}/{expected_peers} expected peers recent")
        return f"{recent}/{len(epochs)} peers recent"

    def probe_forward_containment(self) -> str:
        """The VPS Docker bridges may forward only to the NAS filter ports.

        The rules live in DOCKER-USER independently of wg0 (see
        vps/containment/), so a tunnel restart cannot silently reopen egress.
        Expected order: the read ACCEPT, the optional upload ACCEPT, a DROP for
        every other bridge toward wg0 (Caddy's public bridge included), then the
        unconditional DROPs for the two tunnel bridges.
        """
        r = self._ssh(
            "rules=$(sudo -n iptables -S DOCKER-USER 2>/dev/null "
            "|| iptables -S DOCKER-USER 2>/dev/null) || exit 41; "
            "ip link show immich-tunnel >/dev/null 2>&1 || exit 42; "
            "printf '%s\\n' \"$rules\""
        )
        reasons = {
            41: "DOCKER-USER chain is unreadable or missing",
            42: "tunnel bridge immich-tunnel does not exist (network not recreated?)",
        }
        if r.returncode in reasons:
            raise RuntimeError(reasons[r.returncode])
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200] or "probe failed")

        append_lines = [
            line for line in r.stdout.splitlines() if line.startswith("-A DOCKER-USER ")
        ]
        project_lines = []
        for line in append_lines:
            try:
                tokens = shlex.split(line)
            except ValueError as exc:
                raise RuntimeError("DOCKER-USER contains an unreadable rule") from exc
            if "--comment" in tokens:
                index = tokens.index("--comment")
                if index + 1 < len(tokens) and tokens[index + 1] == "immich-share":
                    project_lines.append(line)
        if len(project_lines) not in {4, 5}:
            raise RuntimeError(
                "unexpected number of immich-share containment rules "
                "(redeploy vps/containment/immich-share-containment.sh)"
            )
        if append_lines[: len(project_lines)] != project_lines:
            raise RuntimeError("immich-share containment rules are not first in DOCKER-USER")

        def parse_rule(line: str) -> tuple[dict[str, str], set[str]]:
            tokens = shlex.split(line)
            if tokens[:2] != ["-A", "DOCKER-USER"]:
                raise RuntimeError("unexpected containment rule chain")
            values: dict[str, str] = {}
            modules: set[str] = set()
            options = {"-i", "-o", "-d", "-p", "--dport", "--comment", "-j"}
            index = 2
            while index < len(tokens):
                option = tokens[index]
                if option == "-m" and index + 1 < len(tokens):
                    modules.add(tokens[index + 1])
                    index += 2
                    continue
                if option not in options or index + 1 >= len(tokens) or option in values:
                    raise RuntimeError("containment rule has an unexpected option")
                values[option] = tokens[index + 1]
                index += 2
            return values, modules

        def validate_accept(line: str, bridge: str, port: str) -> None:
            values, modules = parse_rule(line)
            expected_options = {
                "-i", "-o", "-d", "-p", "--dport", "--comment", "-j"
            }
            if set(values) != expected_options:
                raise RuntimeError("containment ACCEPT rule has an unexpected shape")
            try:
                destination = ipaddress.ip_network(values["-d"], strict=True)
            except ValueError as exc:
                raise RuntimeError("containment destination is not a literal network") from exc
            if (
                values["-i"] != bridge
                or values["-o"] != "wg0"
                or destination.version != 4
                or destination.prefixlen != 32
                or values["-p"] != "tcp"
                or values["--dport"] != port
                or values["--comment"] != "immich-share"
                or values["-j"] != "ACCEPT"
                or modules != {"tcp", "comment"}
            ):
                raise RuntimeError("containment ACCEPT rule is not narrowly scoped")

        def validate_drop(line: str, option: str, interface: str) -> None:
            values, modules = parse_rule(line)
            if (
                values
                != {option: interface, "--comment": "immich-share", "-j": "DROP"}
                or modules != {"comment"}
            ):
                raise RuntimeError("containment DROP rule is not exact")

        validate_accept(project_lines[0], "immich-tunnel", "2283")
        if len(project_lines) == 5:
            validate_accept(project_lines[1], "immich-uptun", "2383")
            drop_lines = project_lines[2:]
        else:
            drop_lines = project_lines[1:]
        validate_drop(drop_lines[0], "-o", "wg0")
        validate_drop(drop_lines[1], "-i", "immich-tunnel")
        validate_drop(drop_lines[2], "-i", "immich-uptun")
        return "bridge egress limited to the NAS filter ports; no other bridge reaches wg0"

    def probe_controller_blocked(self, address: str) -> str:
        try:
            parsed = ipaddress.ip_address(address)
        except ValueError as exc:
            raise RuntimeError("invalid controller WireGuard address") from exc
        if not parsed.is_private:
            raise RuntimeError("controller WireGuard address must be private")
        quoted = shlex.quote(str(parsed))
        r = self._ssh(
            f"if ping -c 1 -W 2 {quoted} >/dev/null 2>&1; then exit 41; fi; "
            f"if nc -z -w 2 {quoted} 22 >/dev/null 2>&1; then exit 42; fi"
        )
        if r.returncode == 41:
            raise RuntimeError("VPS can ping the controller through WireGuard")
        if r.returncode == 42:
            raise RuntimeError("VPS can reach controller TCP/22 through WireGuard")
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[:200] or "probe failed")
        return "VPS-initiated ICMP and TCP/22 are blocked"


# ---------- helpers ----------


def _loopback_host(host: str) -> bool:
    if host.lower() == "localhost":
        return True
    try:
        return ipaddress.ip_address(host).is_loopback
    except ValueError:
        return False


def read_private_file(
    path: Path, label: str, *, max_bytes: int, allow_missing: bool = False
) -> str | None:
    """Read a private regular file once, without following symlinks."""
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    if hasattr(os, "O_CLOEXEC"):
        flags |= os.O_CLOEXEC
    try:
        fd = os.open(path, flags)
    except FileNotFoundError:
        if allow_missing:
            return None
        die(f"{label} file does not exist: {path}")
    except OSError as exc:
        die(f"{label} file cannot be opened securely: {path} ({exc})")
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_mode & 0o077
            or info.st_uid != os.geteuid()
        ):
            die(
                f"{label} file must be regular, owned by the current user, and private: {path}"
            )
        with os.fdopen(fd) as handle:
            fd = -1
            value = handle.read(max_bytes + 1)
    finally:
        if fd >= 0:
            os.close(fd)
    if not value.strip() or len(value) > max_bytes or "\x00" in value:
        die(f"{label} file is empty or invalid: {path}")
    return value


def read_private_secret(path: Path, label: str) -> str:
    """Read a small regular secret file without following symlinks."""
    value = read_private_file(path, label, max_bytes=16_384)
    assert value is not None
    return value.strip()


def parse_ttl(s: str) -> timedelta:
    m = re.fullmatch(r"(\d+)([hdj])", s)
    if not m:
        die(f"invalid TTL '{s}' — expected 24h, 48h, 7d, etc.")
    n, unit = int(m.group(1)), m.group(2)
    ttl = timedelta(hours=n) if unit == "h" else timedelta(days=n)
    if ttl <= timedelta(0):
        die("TTL must be greater than zero")
    return ttl


def gen_password(groups: int = 4) -> str:
    """Four groups of five lowercase letters/digits: about 100 bits, easy to dictate."""
    alphabet = string.ascii_lowercase + string.digits
    return ".".join(
        "".join(secrets.choice(alphabet) for _ in range(5)) for _ in range(groups)
    )


def validate_password(value: str) -> str:
    if len(value) < 16:
        die("custom share passwords must contain at least 16 characters")
    if len(value) > 128 or any(ch in "\r\n\x00" for ch in value):
        die("custom share password is invalid")
    return value


def resolve_open_password(args) -> str:
    password_file = getattr(args, "password_file", None)
    if password_file:
        return validate_password(
            read_private_secret(Path(password_file).expanduser(), "share password")
        )
    if getattr(args, "prompt_password", False):
        first = getpass.getpass("Share password: ")
        second = getpass.getpass("Confirm share password: ")
        if first != second:
            die("share password confirmation does not match")
        return validate_password(first)
    return gen_password()


def print_terminal_qr(url: str) -> bool:
    """Render a link locally without exposing it in the process arguments."""
    qrencode = shutil.which("qrencode")
    if qrencode is None:
        print(
            "  ! QR code unavailable: install qrencode or copy the link above.",
            file=sys.stderr,
        )
        return False
    try:
        result = subprocess.run(
            [qrencode, "-t", "ANSIUTF8"],
            input=url,
            capture_output=True,
            text=True,
            timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        print(
            "  ! QR code generation failed; the share link remains valid.",
            file=sys.stderr,
        )
        return False
    if result.returncode != 0 or not result.stdout:
        print(
            "  ! QR code generation failed; the share link remains valid.",
            file=sys.stderr,
        )
        return False
    print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
    return True


def qr_share_url(public_link: str, password: str, include_password: bool) -> str:
    if not include_password:
        return public_link
    fragment = urllib.parse.urlencode(
        {"ipp-password": password}, quote_via=urllib.parse.quote
    )
    return f"{public_link}#{fragment}"


def check_key(key: str) -> str:
    if not KEY_RE.fullmatch(key):
        die(f"unexpected share key '{key[:40]}' — rejected to prevent Caddy injection")
    return key


def clean_description(value: str) -> str:
    """Remove line breaks before inserting a value into a Caddy comment."""
    return re.sub(r"[\r\n]+", " ", value or "").strip()[:80]


def render_share_snippet(edge: Edge, key: str, description: str, expires: str) -> str:
    share_ref = hashlib.sha256(key.encode()).hexdigest()[:16]
    return SHARE_SNIPPET.format(
        key=key,
        share_ref=share_ref,
        upstream=edge.upstream,
        download_upstream=edge.download_upstream,
        description=clean_description(description) or "-",
        expires=expires,
        uuid=UUID_PATTERN,
        job=ZIP_JOB_PATTERN,
    )


def expired(link: dict) -> bool:
    exp = link.get("expiresAt")
    if not exp:
        return False
    return datetime.fromisoformat(exp.replace("Z", "+00:00")) < datetime.now(
        timezone.utc
    )


def managed_links(
    immich: Immich, state: ManagedShares, include_expired=False
) -> list[dict]:
    owned = state.keys()
    links = [link for link in immich.list_links() if link.get("key") in owned]
    present = {link.get("key") for link in links}
    state.remove(owned - present)
    if include_expired:
        return links
    return [link for link in links if not expired(link)]


def probe_public_root(public_base: str) -> str:
    request = urllib.request.Request(
        public_base.rstrip("/") + "/",
        headers={"User-Agent": "immich-share-doctor/1"},
    )
    try:
        with HTTP_OPENER.open(request, timeout=10) as response:
            raise RuntimeError(f"unexpected HTTP {response.status}; expected 404")
    except urllib.error.HTTPError as exc:
        if exc.code != 404:
            raise RuntimeError(f"unexpected HTTP {exc.code}; expected 404") from exc
    except urllib.error.URLError as exc:
        raise RuntimeError(str(exc.reason)) from exc
    return "closed by default (HTTP 404)"


def probe_api_key_permissions(key_file: Path) -> str:
    mode = key_file.stat().st_mode & 0o777
    if mode & 0o077:
        raise RuntimeError(f"permissions are {mode:04o}; expected 0600")
    return f"{key_file} mode {mode:04o}"


def probe_state_permissions(state: ManagedShares) -> str:
    if not state.path.exists():
        return "no state file yet"
    mode = state.path.stat().st_mode & 0o777
    if mode != 0o600:
        raise RuntimeError(f"permissions are {mode:04o}; expected 0600")
    return f"{state.path} mode 0600"


def run_local(args: list[str]) -> str:
    result = subprocess.run(args, capture_output=True, text=True, timeout=10)
    if result.returncode != 0:
        raise RuntimeError(
            (result.stderr or result.stdout).strip()[:200] or "command failed"
        )
    return result.stdout.strip()


def probe_nas_gate(cfg) -> str:
    command = cfg.get("nas", "doctor_cmd", fallback="").strip()
    if not command:
        raise RuntimeError("[nas] doctor_cmd is required in separate mode")
    try:
        argv = shlex.split(command)
    except ValueError as exc:
        raise RuntimeError("invalid [nas] doctor_cmd") from exc
    if not argv:
        raise RuntimeError("[nas] doctor_cmd is empty")
    result = subprocess.run(argv, capture_output=True, text=True, timeout=30)
    if result.returncode != 0:
        raise RuntimeError(
            (result.stderr or result.stdout).strip()[:240] or "NAS security check failed"
        )
    detail = result.stdout.strip().splitlines()
    return detail[-1][:200] if detail else "NAS boundary checks passed"


def probe_pf_filter(anchor: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", anchor):
        raise RuntimeError("invalid pf anchor name")
    prefix = ["sudo", "-n"] if os.geteuid() != 0 else []
    status = run_local(prefix + ["/sbin/pfctl", "-s", "info"])
    if not re.search(r"Status:\s+Enabled", status):
        raise RuntimeError("macOS packet filter is not enabled")
    rules = run_local(prefix + ["/sbin/pfctl", "-a", anchor, "-sr"])
    if not re.search(r"\bblock\b.*\bin\b", rules):
        raise RuntimeError(f"pf anchor {anchor} has no inbound block rule")
    if not re.search(r"\bpass\b.*\bout\b.*\bkeep state\b", rules):
        raise RuntimeError(f"pf anchor {anchor} has no stateful outbound rule")
    return f"pf enabled with fail-closed {anchor} anchor"


def probe_nas_controller(cfg) -> list[tuple[str, Callable[[], str]]]:
    controller = cfg["controller"] if cfg.has_section("controller") else {}
    wg_container = controller.get("wireguard_container", "wg-tunnel")
    filter_container = controller.get("filter_container", "wg-nginx-filter")
    logrotate_container = controller.get(
        "logrotate_container", "immich-share-logrotate"
    )
    immich_container = controller.get("immich_container", "immich_server")
    share_network = controller.get("immich_share_network", "immich_share")
    vps_address = controller.get("vps_wireguard_address", "").strip()

    def docker_access() -> str:
        run_local(["docker", "info"])
        return "available (Docker access is root-equivalent)"

    def tunnel_running() -> str:
        value = run_local(
            [
                "docker",
                "inspect",
                "--format",
                "{{.State.Running}}",
                wg_container,
            ]
        )
        if value != "true":
            raise RuntimeError(f"{wg_container} is not running")
        return wg_container

    def forwarding_disabled() -> str:
        value = run_local(
            [
                "docker",
                "exec",
                wg_container,
                "sysctl",
                "-n",
                "net.ipv4.ip_forward",
            ]
        )
        if value != "0":
            raise RuntimeError(f"net.ipv4.ip_forward={value}; expected 0")
        return "net.ipv4.ip_forward=0"

    def tunnel_hardening() -> str:
        value = run_local(
            [
                "docker",
                "inspect",
                "--format",
                "{{.HostConfig.ReadonlyRootfs}}|{{json .HostConfig.CapDrop}}|{{json .HostConfig.CapAdd}}|{{json .HostConfig.SecurityOpt}}",
                wg_container,
            ]
        )
        readonly, drops_raw, adds_raw, options_raw = value.split("|", 3)
        if (
            readonly != "true"
            or set(json.loads(drops_raw) or []) != {"ALL"}
            # DAC_READ_SEARCH lets root read the mode-0600 bind-mounted wg0.conf
            # after cap_drop ALL (see nas/docker-compose.yml).
            or set(json.loads(adds_raw) or []) != {"NET_ADMIN", "DAC_READ_SEARCH"}
            or not any(
                option.startswith("no-new-privileges")
                for option in (json.loads(options_raw) or [])
            )
        ):
            raise RuntimeError("WireGuard container hardening is incomplete")
        return "read-only, NET_ADMIN+DAC_READ_SEARCH only, no-new-privileges"

    def dedicated_network() -> str:
        output = run_local(
            [
                "docker",
                "network",
                "inspect",
                "--format",
                "{{range .Containers}}{{.Name}}\n{{end}}",
                share_network,
            ]
        )
        members = set(output.splitlines())
        expected = {wg_container, immich_container}
        if members != expected:
            raise RuntimeError(
                f"{share_network} members are {sorted(members)}; expected {sorted(expected)}"
            )
        return f"{share_network}: {', '.join(sorted(members))}"

    def vps_ssh_port() -> str:
        if not vps_address:
            raise RuntimeError(
                "[controller] vps_wireguard_address is required in NAS mode"
            )
        run_local(
            [
                "docker",
                "exec",
                wg_container,
                "nc",
                "-z",
                "-w",
                "3",
                vps_address,
                "22",
            ]
        )
        return f"{vps_address}:22 reachable through {wg_container}"

    def filter_exists() -> str:
        wg_id = run_local(
            [
                "docker",
                "inspect",
                "--format",
                "{{.Id}}",
                wg_container,
            ]
        )
        value = run_local(
            [
                "docker",
                "inspect",
                "--format",
                "{{.HostConfig.NetworkMode}}",
                filter_container,
            ]
        )
        if value != f"container:{wg_id}":
            raise RuntimeError(
                f"{filter_container} does not share {wg_container}: {value}"
            )
        return f"{filter_container} shares the tunnel network namespace"

    def filter_hardening() -> str:
        value = run_local(
            [
                "docker",
                "inspect",
                "--format",
                "{{.Config.User}}|{{.HostConfig.ReadonlyRootfs}}|{{json .HostConfig.CapDrop}}|{{json .HostConfig.CapAdd}}|{{json .HostConfig.SecurityOpt}}",
                filter_container,
            ]
        )
        user, readonly, drops_raw, adds_raw, options_raw = value.split("|", 4)
        if user not in {"101", "101:101"}:
            raise RuntimeError(f"unexpected filter user: {user or 'root'}")
        if (
            readonly != "true"
            or set(json.loads(drops_raw) or []) != {"ALL"}
            or set(json.loads(adds_raw) or [])
            or not any(
                option.startswith("no-new-privileges")
                for option in (json.loads(options_raw) or [])
            )
        ):
            raise RuntimeError("filter container hardening is incomplete")
        return "non-root, read-only, no capabilities"

    def log_rotation() -> str:
        value = run_local(
            [
                "docker",
                "inspect",
                "--format",
                "{{.State.Running}}|{{.Config.User}}|{{.HostConfig.ReadonlyRootfs}}|{{.HostConfig.NetworkMode}}|{{json .HostConfig.CapDrop}}|{{json .HostConfig.CapAdd}}|{{json .HostConfig.SecurityOpt}}",
                logrotate_container,
            ]
        )
        running, user, readonly, network, drops, adds, options = value.split("|", 6)
        if (
            running != "true"
            or user not in {"101", "101:101"}
            or readonly != "true"
            or network != "none"
            or set(json.loads(drops) or []) != {"ALL"}
            or set(json.loads(adds) or [])
            or not any(
                option.startswith("no-new-privileges")
                for option in (json.loads(options) or [])
            )
        ):
            raise RuntimeError(f"{logrotate_container} hardening is incomplete")
        return f"{logrotate_container} is isolated and running"

    return [
        ("NAS Docker access", docker_access),
        ("NAS WireGuard container", tunnel_running),
        ("NAS forwarding disabled", forwarding_disabled),
        ("NAS tunnel hardening", tunnel_hardening),
        ("NAS dedicated Immich network", dedicated_network),
        ("NAS-to-VPS SSH transport", vps_ssh_port),
        ("NAS filtering nginx", filter_exists),
        ("NAS filter hardening", filter_hardening),
        ("NAS bounded log rotation", log_rotation),
    ]


