# Generated at startup from UPLOAD_* variables only.

map $http_x_client_ip $upload_client_key {
    "" $remote_addr;
    default $http_x_client_ip;
}

map $http_x_upload_guard $upload_guard_authorized {
    default 0;
    "caddy-internal-v1" 1;
}

map "$request_method:$uri" $upload_action {
    default denied;

    "~^GET:/drop/i/[A-Za-z0-9_-]{32,128}/?$" invite_ui;
    "~^GET:/drop/assets/(?:app\.js|drop\.css|favicon\.png)$" asset;
    "~^POST:/drop/api/invites/[A-Za-z0-9_-]{32,128}/unlock/?$" unlock;
    "~^GET:/drop/api/invites/[A-Za-z0-9_-]{32,128}/policy/?$" policy;
    "~^POST:/drop/api/invites/[A-Za-z0-9_-]{32,128}/uploads/?$" create_upload;
    "~^HEAD:/drop/api/uploads/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/?$" upload_status;
    "~^PATCH:/drop/api/uploads/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/?$" upload_chunk;
    "~^DELETE:/drop/api/uploads/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/?$" upload_cancel;
}

map $upload_action $upload_route_allowed {
    default 1;
    denied 0;
}

limit_req_zone $upload_client_key zone=upload_rate:1m rate=${UPLOAD_REQUEST_RATE};
limit_conn_zone $upload_client_key zone=upload_per_ip:1m;
limit_conn_zone $server_name zone=upload_global:1m;

# No request target, token, cookie, filename, or query is recorded.
log_format upload_guard
    '$time_iso8601 client=$upload_client_key action=$upload_action '
    'status=$status bytes=$body_bytes_sent duration=$request_time';

server {
    listen 8081;
    server_name upload-guard;
    server_tokens off;

    access_log /dev/stdout upload_guard;
    error_log /dev/null;

    client_max_body_size 4k;
    client_header_timeout 10s;
    client_body_timeout 30s;
    send_timeout 60s;

    limit_req_status 429;
    limit_req_log_level notice;
    limit_conn_status 429;
    error_page 429 = @upload_busy;

    location @upload_busy {
        default_type application/json;
        add_header Retry-After 30 always;
        add_header Cache-Control "no-store" always;
        return 429 '{"error":"too_many_requests"}\n';
    }

    # Only the session-owned upload resource accepts raw chunks. HEAD and
    # DELETE share the location but carry no useful request body; the route map
    # still rejects every method outside the public contract.
    location ~ "^/drop/api/uploads/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/?$" {
        client_max_body_size ${UPLOAD_MAX_BODY};
        if ($upload_guard_authorized = 0) {
            return 403;
        }
        if ($upload_route_allowed = 0) {
            return 404;
        }

        limit_req zone=upload_rate burst=60 nodelay;
        limit_conn upload_per_ip ${UPLOAD_PER_IP};
        limit_conn upload_global ${UPLOAD_GLOBAL};

        proxy_pass http://${UPLOAD_NAS_WG_ADDRESS}:2383;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 2m;
        proxy_read_timeout 2m;

        proxy_set_header Host upload-drop;
        proxy_set_header X-Client-IP $upload_client_key;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Upload-Guard "";
        proxy_set_header Connection "";
    }

    # Invitation HTML/assets, unlock JSON, policy and upload creation are all
    # small. A 4-KiB ceiling prevents large JSON bodies from consuming memory.
    location / {
        client_max_body_size 4k;
        if ($upload_guard_authorized = 0) {
            return 403;
        }
        if ($upload_route_allowed = 0) {
            return 404;
        }

        limit_req zone=upload_rate burst=60 nodelay;
        limit_conn upload_per_ip ${UPLOAD_PER_IP};
        limit_conn upload_global ${UPLOAD_GLOBAL};

        proxy_pass http://${UPLOAD_NAS_WG_ADDRESS}:2383;
        proxy_http_version 1.1;
        # Raw chunks stream through the VPS. The bounded tmpfs remains a
        # fail-closed safety net; uploaded bytes never enter persistent storage.
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 5s;
        proxy_send_timeout 2m;
        proxy_read_timeout 2m;

        proxy_set_header Host upload-drop;
        proxy_set_header X-Client-IP $upload_client_key;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Upload-Guard "";
        proxy_set_header Connection "";
    }
}
