# Caddy 2.11.9 and the rate-limit module, both pinned. The digest identifies the
# multi-architecture index so this Dockerfile works on amd64 and arm64.
FROM caddy:2.11.9-builder@sha256:3fddbec729442a56b942d4c9eaef1df80893dbf2cf5b86701bfae6aad1408eeb AS builder
# GitHub-hosted runners intermittently receive HTTP/2 stream resets from the
# Go module proxy and checksum database. This affects build transport only;
# force the Go client to HTTP/1.1 for a reproducible xcaddy fetch.
ENV GODEBUG=http2client=0
# The --replace pins lift transitive Go modules past the versions Trivy flags
# (HIGH/CRITICAL gate in CI); bump them when the scan turns red.
RUN xcaddy build \
    --with github.com/mholt/caddy-ratelimit@v0.1.0 \
    --replace golang.org/x/net=golang.org/x/net@v0.62.0

FROM caddy:2.11.9-alpine@sha256:0bbb055bda6793c999bde78b1b5ce3e89f829fb031af2cf50056ea1246559fee
# curl is unused. Removing it reduces the installed attack surface.
RUN apk upgrade --no-cache \
 && apk del --no-cache curl
COPY --from=builder /usr/bin/caddy /usr/bin/caddy
