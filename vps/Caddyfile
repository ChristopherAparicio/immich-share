# Closed-by-default portal.
# Validate rate_limit syntax against the module README during deployment:
#    https://github.com/mholt/caddy-ratelimit
{
	# `first` is required because imported handle blocks otherwise terminate routing.
	order rate_limit first

	# Long Safari iOS ZIP downloads were interrupted over HTTP/3 while the same
	# transfer completed over HTTP/1.1. HTTP/2 keeps TLS and multiplexing over TCP.
	servers :443 {
		protocols h1 h2
	}

	# Reverse-proxy failures are emitted by Caddy's runtime logger, separately
	# from the redacted site access log below. Apply the same field filter so an
	# unavailable upstream cannot place a share key or upload token in Docker
	# logs through request.uri.
	log default {
		output stderr
		format filter {
			request>uri replace REDACTED
		}
	}
}

{$PUBLIC_DOMAIN:photos.example.com} {
	# Shared-link authentication rate limit. IPP has no built-in throttle.
	# /share/unlock is global because the key is carried in the request body.
	# The matcher belongs inside the zone; an external Caddy matcher is ignored.
	rate_limit {
		zone share_auth {
			match {
				method POST
				path /share/unlock
			}
			key {remote_host}
			ipv6_prefix 64
			events 10
			window 1m
		}
		# Absorb repeated clicks. The download guard handles long-lived concurrency.
		zone share_bulk_download {
			match {
				method GET POST
				path /share/*/download /s/*/download
			}
			key {remote_host}
			ipv6_prefix 64
			events 10
			window 1m
		}
		# Queue preparation/status polling is authenticated by the share session.
		# Two-second polling needs a separate, higher bounded allowance.
		zone share_zip_queue {
			match {
				method GET POST DELETE
				path /share/*/download/prepare /share/*/download/jobs/*
			}
			key {remote_host}
			ipv6_prefix 64
			events 120
			window 1m
		}
		# Planning performs bounded header requests against Immich. Keep it on a
		# deliberately smaller per-client budget than inexpensive status polls.
		zone share_zip_plan {
			match {
				method POST
				path /share/*/download/plan
			}
			key {remote_host}
			ipv6_prefix 64
			events 6
			window 1m
		}
		# Upload authentication receives a deliberately small brute-force budget.
		zone drop_auth {
			match {
				method POST
				path /drop/api/invites/*/unlock
			}
			key {remote_host}
			ipv6_prefix 64
			events 10
			window 1m
		}
		# Upload creation is more expensive than status/resume requests.
		zone drop_create {
			match {
				method POST
				path /drop/api/invites/*/uploads
			}
			key {remote_host}
			ipv6_prefix 64
			events 20
			window 1m
		}
		# Eight-MiB resumable chunks naturally provide fairness. This guards request
		# starts; nginx owns long-lived concurrency and the app owns byte quotas.
		zone drop_chunks {
			match {
				method HEAD PATCH DELETE
				path /drop/api/uploads/*
			}
			key {remote_host}
			ipv6_prefix 64
			events 120
			window 1m
		}
	}

	# Browser defenses: strict TLS, no framing, and no share-key leakage in Referer.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		-Server
	}

	# One generated file per active share. An empty directory exposes no handler.
	import /etc/caddy/shares.d/*.caddy
	# A single generic upload snippet is installed only while at least one
	# invitation is active. The backend enforces each invitation's expiry on
	# every request; an empty directory therefore remains closed by default.
	import /etc/caddy/drops.d/*.caddy

	# Keep short-lived request telemetry without recording credential-bearing
	# share keys or secret query values. Generated share routes append only a
	# one-way share reference and a coarse action for home-side telemetry.
	log {
		output file /data/access.log {
			mode 0600
			roll_size 5mb
			roll_keep 1
			roll_keep_for 24h
		}
		format filter {
			# A single replacement is deliberately stronger than chained path/query
			# filters: Caddy stores one result per field and later filters can expose
			# the original value again.
			request>uri replace REDACTED
		}
	}

	handle {
		respond "Not found" 404
	}
}
