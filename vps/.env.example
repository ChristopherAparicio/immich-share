# Default safety limits for a small VPS. They do not reserve memory or CPU;
# they only cap maximum consumption.
PUBLIC_DOMAIN=photos.example.com
# Private WireGuard address assigned to the NAS. Replace locally; do not commit
# the real value.
NAS_WG_ADDRESS=REPLACE_WITH_NAS_WG_ADDRESS

CADDY_MEMORY_LIMIT=128m
CADDY_CPU_LIMIT=0.50
CADDY_PIDS_LIMIT=128

IPP_MEMORY_LIMIT=512m
IPP_CPU_LIMIT=1.00
IPP_PIDS_LIMIT=256
IPP_TMPFS_SIZE=256m

# Individual-download limiter. `2m` means 2 MiB/s per response. Maximum
# aggregate throughput is approximately RATE × GLOBAL.
DOWNLOAD_RATE=2m
DOWNLOAD_RATE_AFTER=1m
DOWNLOAD_PER_IP=2
DOWNLOAD_GLOBAL=6
DOWNLOAD_LIMIT_DRY_RUN=off

# ZIP: up to three concurrent prepared transfers, each at 2 MiB/s after the
# first MiB. Only one new archive is staged at a time. The staging/archive pair
# may use at most 50% of free space left after the reserve.
ZIP_RATE=2m
ZIP_RATE_AFTER=1m
ZIP_GLOBAL=3
# Concurrent ZIP transfers per client address; a slow reader cannot hold
# more than this many of the ZIP_GLOBAL slots.
ZIP_PER_IP=1
ZIP_MAX_PARALLEL_DOWNLOADS=3
ZIP_DISK_BUDGET_PERCENT=50
ZIP_SPLIT_THRESHOLD_BYTES=1073741824
ZIP_PART_TARGET_BYTES=536870912
ZIP_PLAN_CONCURRENCY=12
DOWNLOAD_GUARD_MEMORY_LIMIT=64m
DOWNLOAD_GUARD_CPU_LIMIT=0.25
DOWNLOAD_GUARD_PIDS_LIMIT=32

# Sovereign upload-drop guard. The upload service and storage stay on the NAS;
# this edge container streams bounded requests and has no persistent volume.
# Use the dedicated upload WireGuard peer address, not NAS_WG_ADDRESS.
UPLOAD_NAS_WG_ADDRESS=REPLACE_WITH_UPLOAD_NAS_WG_ADDRESS
UPLOAD_MAX_BODY=9m
UPLOAD_REQUEST_RATE=30r/s
UPLOAD_PER_IP=2
UPLOAD_GLOBAL=6
UPLOAD_GUARD_MEMORY_LIMIT=64m
UPLOAD_GUARD_CPU_LIMIT=0.25
UPLOAD_GUARD_PIDS_LIMIT=48
