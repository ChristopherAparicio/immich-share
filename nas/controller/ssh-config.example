# Merge this block into the NAS controller user's ~/.ssh/config.
Host vps-photos-via-wg
    HostName <WG_VPS_ADDRESS>
    User debian
    IdentityFile ~/.config/immich-share/vps-controller-key
    IdentitiesOnly yes
    ForwardAgent no
    ClearAllForwardings yes
    RequestTTY no
    HostKeyAlias vps-photos-wireguard
    # Requires WG_CONTROLLER_SSH_PEER=<WG_VPS_ADDRESS> on wg-tunnel; the tunnel
    # namespace's OUTPUT allowlist drops this TCP/22 connection otherwise.
    ProxyCommand docker exec -i wg-tunnel nc %h %p
