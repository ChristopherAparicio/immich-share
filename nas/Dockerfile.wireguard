# Minimal WireGuard client. The previous general-purpose LinuxServer image also
# bundled server-mode DNS and helper binaries that are unnecessary here.
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN apk upgrade --no-cache \
    && apk add --no-cache \
      bash \
      iptables \
      iproute2 \
      netcat-openbsd \
      openresolv \
      socat \
      wireguard-tools

COPY wireguard-entrypoint.sh /usr/local/sbin/wireguard-entrypoint
ENTRYPOINT ["/usr/local/sbin/wireguard-entrypoint"]
