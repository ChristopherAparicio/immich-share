# Validate with: visudo -cf /etc/sudoers.d/immich-share-forward-gate
# The account is intentionally NOT a member of the root-equivalent Docker group.
Cmnd_Alias IMMICH_SHARE_FORWARD = /usr/bin/docker start wg-nginx-filter, \
    /usr/bin/docker stop --time 10 wg-nginx-filter, \
    /usr/bin/docker inspect --format {{.State.Running}} wg-nginx-filter, \
    /usr/local/sbin/immich-share-security-doctor, \
    /usr/bin/docker start wg-upload-filter, \
    /usr/bin/docker stop --time 10 wg-upload-filter, \
    /usr/bin/docker inspect --format {{.State.Running}} wg-upload-filter, \
    /usr/local/sbin/immich-share-upload-security-doctor, \
    /usr/local/sbin/immich-share-upload-admin open, \
    /usr/local/sbin/immich-share-upload-admin list, \
    /usr/local/sbin/immich-share-upload-admin close, \
    /usr/local/sbin/immich-share-upload-admin sweep, \
    /usr/bin/test -f /var/log/immich-share/denied.log, \
    /usr/bin/tail -F -n0 /var/log/immich-share/denied.log

immich-share-gate ALL=(root) NOPASSWD: IMMICH_SHARE_FORWARD
