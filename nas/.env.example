# Conservative ceilings; Immich, not this proxy, carries the photo workload.
# Dedicated network shared by immich_server and the filtering gateway only.
# Do not use Immich's default network: it also contains PostgreSQL and Redis.
IMMICH_SHARE_DOCKER_NETWORK=immich_share
# Private WireGuard address assigned to the NAS. Replace locally; do not commit
# the real value.
NAS_WG_ADDRESS=REPLACE_WITH_NAS_WG_ADDRESS

WG_MEMORY_LIMIT=128m
WG_CPU_LIMIT=0.50
WG_PIDS_LIMIT=128

NGINX_MEMORY_LIMIT=96m
NGINX_CPU_LIMIT=0.50
NGINX_PIDS_LIMIT=64

# Optional sovereign upload-drop stack. This is a second trust boundary: it
# must never join IMMICH_SHARE_DOCKER_NETWORK and receives no Immich API key.
IMMICH_DROP_DOCKER_NETWORK=immich_drop
UPLOAD_NAS_WG_ADDRESS=REPLACE_WITH_UPLOAD_NAS_WG_ADDRESS

# Reviewed multi-architecture v0.1.1 release, pinned by immutable digest.
UPLOAD_DROP_IMAGE=ghcr.io/christopheraparicio/immich-drop:v0.1.1@sha256:85f667d0f6fc18dec813dcb6dc53ac81d9db0de8a55b82d8303883f0f8bae376

# Host paths stay in this ignored deployment file. Use separate dedicated
# directories/datasets, owned by the non-root application UID/GID
# (65532:65532), mode 0700. The secret is a 32-byte mode-0400 regular file owned
# by the same UID/GID. A filesystem quota on storage is strongly recommended.
UPLOAD_DROP_STORAGE_PATH=REPLACE_WITH_UPLOAD_DROP_STORAGE_PATH
UPLOAD_DROP_STATE_PATH=REPLACE_WITH_UPLOAD_DROP_STATE_PATH
UPLOAD_DROP_SESSION_SECRET_FILE=REPLACE_WITH_UPLOAD_DROP_SESSION_SECRET_FILE
# HTTPS origin only; do not append /drop.
UPLOAD_PUBLIC_BASE_URL=https://photos.example.com

# Secure application defaults. The application enforces these independently of
# the VPS and NAS nginx guards so a bypassed edge still fails closed.
UPLOAD_DROP_GLOBAL_BUDGET_BYTES=21474836480
UPLOAD_DROP_DISK_RESERVE_BYTES=5368709120
UPLOAD_DROP_DEFAULT_MAX_FILE_BYTES=536870912
UPLOAD_DROP_DEFAULT_MAX_FILES=500
UPLOAD_DROP_DEFAULT_QUOTA_BYTES=1073741824
UPLOAD_DROP_CHUNK_BYTES=8388608
UPLOAD_DROP_CHUNK_TIMEOUT_SECONDS=180
UPLOAD_DROP_INCOMPLETE_TTL_SECONDS=86400
UPLOAD_DROP_SWEEP_INTERVAL_SECONDS=300
UPLOAD_DROP_SESSION_MAX_AGE_SECONDS=43200
UPLOAD_DROP_MAX_CLIENT_CONCURRENCY=2
UPLOAD_DROP_MAX_ACTIVE_UPLOADS=3
UPLOAD_DROP_MAX_ACTIVE_UNLOCKS=2
UPLOAD_DROP_MAX_INVITE_TTL_SECONDS=604800
UPLOAD_DROP_LOG_LEVEL=INFO
UPLOAD_DROP_MEMORY_LIMIT=384m
UPLOAD_DROP_CPU_LIMIT=1.00
UPLOAD_DROP_PIDS_LIMIT=192

UPLOAD_WG_MEMORY_LIMIT=128m
UPLOAD_WG_CPU_LIMIT=0.50
UPLOAD_WG_PIDS_LIMIT=128

UPLOAD_FILTER_MEMORY_LIMIT=96m
UPLOAD_FILTER_CPU_LIMIT=0.50
UPLOAD_FILTER_PIDS_LIMIT=64
UPLOAD_FILTER_MAX_BODY=9m
UPLOAD_FILTER_REQUEST_RATE=30r/s
UPLOAD_FILTER_PER_IP=2
UPLOAD_FILTER_GLOBAL=6
