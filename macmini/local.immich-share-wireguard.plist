<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Root LaunchDaemon: runs the fail-closed pf + WireGuard start script once
         per boot, so it logs to /var/log rather than a user home. It is a
         one-shot (no KeepAlive); ThrottleInterval only bounds manual restarts.
         wg-quick execs wg/wireguard-go/bash by name, so PATH must list the
         root-owned tool directory first (see start-wireguard-fail-closed.sh and
         pf-wireguard.md). It must never include the operator-owned Homebrew
         prefix: this daemon runs as root. -->
    <key>Label</key>
    <string>local.immich-share-wireguard</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/sbin/immich-share-wireguard-start</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/libexec/immich-share-wireguard:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/var/log/immich-share-wireguard.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/immich-share-wireguard.log</string>
</dict>
</plist>
