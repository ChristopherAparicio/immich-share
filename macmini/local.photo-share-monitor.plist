<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Replace <CONTROLLER_INSTALL_DIR> with the private checkout path and
       <CONTROLLER_HOME> with the controller account's home directory: launchd
       does not expand ~ or $HOME. Create the log directory once with
       mkdir -p ~/Library/Logs/immich-share before loading the agent. -->
  <key>Label</key><string>local.photo-share-monitor</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>&lt;CONTROLLER_INSTALL_DIR&gt;/macmini/photo-share-monitor.py</string>
  </array>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>&lt;CONTROLLER_HOME&gt;/Library/Logs/immich-share/photo-share-monitor.log</string>
  <key>StandardErrorPath</key><string>&lt;CONTROLLER_HOME&gt;/Library/Logs/immich-share/photo-share-monitor.log</string>
</dict></plist>
